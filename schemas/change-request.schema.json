{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doistech.example/schemas/change-request.schema.json",
  "title": "DPF Change Request Contract",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "./_common.schema.json#/$defs/commonDocumentMetadata"
    }
  ],
  "required": [
    "id",
    "requested_change",
    "rationale",
    "affected_artifact_ids",
    "impact_summary",
    "risks",
    "recommendation"
  ],
  "properties": {
    "contract_version": {
      "$ref": "./_common.schema.json#/$defs/version"
    },
    "artifact_type": {
      "const": "change-request"
    },
    "id": {
      "$ref": "./_common.schema.json#/$defs/changeRequestId"
    },
    "title": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    },
    "version": {
      "$ref": "./_common.schema.json#/$defs/version"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "archived"
      ]
    },
    "priority": {
      "type": "string"
    },
    "owner": {
      "$ref": "./_common.schema.json#/$defs/person"
    },
    "author": {
      "$ref": "./_common.schema.json#/$defs/person"
    },
    "approver": {
      "$ref": "./_common.schema.json#/$defs/person"
    },
    "created_at": {
      "$ref": "./_common.schema.json#/$defs/date"
    },
    "updated_at": {
      "$ref": "./_common.schema.json#/$defs/date"
    },
    "requested_change": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    },
    "rationale": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    },
    "affected_artifact_ids": {
      "$ref": "./_common.schema.json#/$defs/referenceArray"
    },
    "impact_summary": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    },
    "risks": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "recommendation": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    },
    "related_decision_ids": {
      "type": "array",
      "items": {
        "$ref": "./_common.schema.json#/$defs/decisionId"
      },
      "default": []
    },
    "release_id": {
      "$ref": "./_common.schema.json#/$defs/releaseId"
    },
    "document_refs": {
      "$ref": "./_common.schema.json#/$defs/referenceArray"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "./_common.schema.json#/$defs/historyEntry"
      }
    }
  }
}

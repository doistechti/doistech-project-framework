{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doistech.example/schemas/task.schema.json",
  "title": "DPF Task Contract",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "./_common.schema.json#/$defs/commonDocumentMetadata"
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "canceled"
          }
        }
      },
      "then": {
        "required": [
          "cancellation_reason"
        ]
      }
    }
  ],
  "required": [
    "id",
    "parent_feature_id",
    "objective",
    "scope",
    "out_of_scope",
    "inputs",
    "outputs",
    "validation_criteria",
    "tests",
    "definition_of_ready",
    "definition_of_done"
  ],
  "properties": {
    "contract_version": {
      "$ref": "./_common.schema.json#/$defs/version"
    },
    "artifact_type": {
      "const": "task"
    },
    "id": {
      "$ref": "./_common.schema.json#/$defs/taskId"
    },
    "title": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    },
    "version": {
      "$ref": "./_common.schema.json#/$defs/version"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "active",
        "blocked",
        "done",
        "validated",
        "canceled",
        "archived"
      ]
    },
    "priority": {
      "type": "string"
    },
    "owner": {
      "$ref": "./_common.schema.json#/$defs/person"
    },
    "author": {
      "$ref": "./_common.schema.json#/$defs/person"
    },
    "approver": {
      "$ref": "./_common.schema.json#/$defs/person"
    },
    "created_at": {
      "$ref": "./_common.schema.json#/$defs/date"
    },
    "updated_at": {
      "$ref": "./_common.schema.json#/$defs/date"
    },
    "parent_feature_id": {
      "$ref": "./_common.schema.json#/$defs/featureId"
    },
    "objective": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    },
    "scope": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "out_of_scope": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "allowed_areas": {
      "$ref": "./_common.schema.json#/$defs/referenceArray"
    },
    "restrictions": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "inputs": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "outputs": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "dependencies": {
      "$ref": "./_common.schema.json#/$defs/referenceArray"
    },
    "acceptance_criteria_ids": {
      "$ref": "./_common.schema.json#/$defs/referenceArray"
    },
    "validation_criteria": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "tests": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "definition_of_ready": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "definition_of_done": {
      "$ref": "./_common.schema.json#/$defs/stringArray"
    },
    "executor_agent": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    },
    "related_decision_ids": {
      "type": "array",
      "items": {
        "$ref": "./_common.schema.json#/$defs/decisionId"
      },
      "default": []
    },
    "release_id": {
      "$ref": "./_common.schema.json#/$defs/releaseId"
    },
    "result": {
      "type": "string"
    },
    "document_refs": {
      "$ref": "./_common.schema.json#/$defs/referenceArray"
    },
    "evidence_refs": {
      "$ref": "./_common.schema.json#/$defs/referenceArray"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "./_common.schema.json#/$defs/historyEntry"
      }
    },
    "cancellation_reason": {
      "$ref": "./_common.schema.json#/$defs/nonEmptyString"
    }
  }
}
